var hosts = document.querySelectorAll('typebot-standard, typebot-bubble, [id*=\"typebot\"]');\n    var root = document;\n\n    hosts.forEach(function(host) {\n      if (host.shadowRoot) root = host.shadowRoot;\n    });\n\n    var iframes = document.querySelectorAll('iframe');\n    iframes.forEach(function(iframe) {\n      try {\n        var iframeDoc = iframe.contentDocument || iframe.contentWindow.document;\n        if (iframeDoc && iframeDoc.body) {\n          root = iframeDoc;\n        }\n      } catch(e) {}\n    });\n\n    // 1. Encontra todos os avatares de bot no chat em ordem\n    var avatars = [];\n    var allImgs = (root.body || root).querySelectorAll('img');\n    allImgs.forEach(function(img) {\n      var w = img.offsetWidth || img.naturalWidth || 0;\n      var h = img.offsetHeight || img.naturalHeight || 0;\n      var isAvatar = ((w > 15 && w <= 60) || (h > 15 && h <= 60)) || (img.src.indexOf('DfSWSsHJ') !== -1);\n      if (isAvatar) {\n        avatars.push(img);\n      }\n    });\n\n    // 2. O primeiro avatar (index 0) é o Spotify. Os próximos (index > 0) são a atendente\n    avatars.forEach(function(img, index) {\n      if (listeningImgs.indexOf(img) === -1) {\n        listeningImgs.push(img);\n        img.addEventListener('load', run);\n      }\n\n      if (index > 0) { // A partir do segundo avatar (Etapa 2 em diante)\n        if (img.src.indexOf('Captura-de-Tela') === -1) {\n          img.src = attendantUrl;\n          img.style.objectFit = 'cover';\n        }\n      }\n    });\n  }\n\n  // Roda a cada frame (60x/segundo) - velocidade máxima que resolveu o piscar\n  function loop() {\n    run();\n    requestAnimationFrame(loop);\n  }\n  requestAnimationFrame(loop);\n\n  // MutationObserver como camada extra que resolveu o piscar\n  var observer = new MutationObserver(run);\n  observer.observe(document.body, { \n    childList: true, \n    subtree: true,\n    attributes: true,\n    attributeFilter: ['src']\n  });\n})();\n</script>"},"selectedThemeTemplateId":null,"settings":{"general":{"isBrandingEnabled":false,"isHideQueryParamsEnabled":false},"typingEmulation":{"enabled":true,"speed":300,"maxDelay":1.5},"metadata":{"title":"Spotify","description":" ","imageUrl":"https://s3.fr-par.scw.cloud/typebot/public/typebots/r84jdu7bjz19lcijs97fohsc/ogImage?v=1687632342887","favIconUrl":"https://s3.fr-par.scw.cloud/typebot/public/typebots/clll1f2no0005la0fac17sm07/favIcon?v=1692635066466","customHeadCode":"<!-- Troca avatar: Spotify -> Atendente após Kaytlynn entrar -->\n<script>\n(function() {\n  var attendantUrl = 'https://i.postimg.cc/1tLmq831/Captura-de-Tela-2026-07-08-a-s-17-22-22.png';\n  var listeningImgs = [];\n\n  function run() {\n    var hosts = document.querySelectorAll('typebot-standard, typebot-bubble, [id*=\"typebot\"]');\n    var root = document;\n\n    hosts.forEach(function(host) {\n      if (host.shadowRoot) root = host.shadowRoot;\n    });\n\n    var iframes = document.querySelectorAll('iframe');\n    iframes.forEach(function(iframe) {\n      try {\n        var iframeDoc = iframe.contentDocument || iframe.contentWindow.document;\n        if (iframeDoc && iframeDoc.body && iframeDoc.body.innerText.indexOf('Kaytlynn') !== -1) {\n          root = iframeDoc;\n        }\n      } catch(e) {}\n    });\n\n    var textContent = root.body ? root.body.innerText : (root.textContent || root.innerText || '');\n    if (textContent.indexOf('Kaytlynn') === -1) return;\n\n    var kaytlynnEl = null;\n    try {\n      var walker = document.createTreeWalker(root.body || root, NodeFilter.SHOW_TEXT);\n      while (walker.nextNode()) {\n        if (walker.currentNode.textContent.indexOf('Kaytlynn') !== -1) {\n          kaytlynnEl = walker.currentNode.parentElement;\n          break;\n        }\n      }\n    } catch(e) {}\n\n    if (!kaytlynnEl) return;\n\n    function isInSameGroupAsKaytlynn(img) {\n      var el = img;\n      while (el && el.parentElement) {\n        el = el.parentElement;\n        var t = el.textContent || '';\n        if (t.indexOf('Kaytlynn') !== -1) {\n          var innerImgs = el.querySelectorAll('img');\n          var avatarCount = 0;\n          for (var j = 0; j < innerImgs.length; j++) {\n            var iw = innerImgs[j].offsetWidth || innerImgs[j].naturalWidth || 0;\n            var ih = innerImgs[j].offsetHeight || innerImgs[j].naturalHeight || 0;\n            if ((iw > 15 && iw <= 60) || (ih > 15 && ih <= 60) ||\n                innerImgs[j].src.indexOf('DfSWSsHJ') !== -1 ||\n                innerImgs[j].src.indexOf('Captura-de-Tela') !== -1) {\n              avatarCount++;\n            }\n          }\n          return avatarCount <= 1;\n        }\n      }\n      return false;\n    }\n\n    var allImgs = (root.body || root).querySelectorAll('img');\n    allImgs.forEach(function(img) {\n      if (listeningImgs.indexOf(img) === -1) {\n        listeningImgs.push(img);\n        img.addEventListener('load', run);\n      }\n\n      var w = img.offsetWidth || img.naturalWidth || 0;\n      var h = img.offsetHeight || img.naturalHeight || 0;\n      if ((w > 15 && w <= 60) || (h > 15 && h <= 60)) {\n        try {\n          var isAfter = !!(kaytlynnEl.compareDocumentPosition(img) & Node.DOCUMENT_POSITION_FOLLOWING);\n          var isSameGroup = isInSameGroupAsKaytlynn(img);\n\n          if (isAfter || isSameGroup) {\n            if (img.src.indexOf('Captura-de-Tela') === -1) {\n              img.src = attendantUrl;\n              img.style.objectFit = 'cover';\n            }\n          }\n        } catch(e) {}\n      }\n    });\n  }\n\n  function loop() {\n    run();\n    requestAnimationFrame(loop);\n  }\n  requestAnimationFrame(loop);\n\n  var observer = new MutationObserver(run);\n  observer.observe(document.body, {\n    childList: true,\n    subtree: true,\n    attributes: true,\n    attributeFilter: ['src']\n  });\n})();\n</script>\n\n<!-- Widget de Checkout Hotmart -->\n<script type=\"text/javascript\">\n  function importHotmart(){ \n    var imported = document.